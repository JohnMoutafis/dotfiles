;; defsrc is still necessary
(defcfg
  process-unmapped-keys yes
)

(defsrc
       f1 f2  f3  f4  f5  f6  f7  f8  f9  f10  f11  f12
                                                         bspc
                              u
  caps a  s   d   f       h   j   k   l   ;
  fn                 spc
)

(defvar
  tap-time 150
  hold-time 200
)

(defalias
  ;; On MacOS fn functionality gets disabled by kanata.
  fnl (tap-hold $tap-time $hold-time fn (layer-toggle fn))
  
  ;; Caps Lock: Click = Esc, Hold = Left Ctrl
  escctrl (tap-hold $tap-time $hold-time esc lctl)
  
  ;; Hold Space to use jkl; as arrows
  sparr (tap-hold $tap-time $hold-time spc (layer-toggle arrows))
  
  ;; Home row mods: Cmd, Alt, Ctrl, Shift
  a (tap-hold $tap-time $hold-time a lctl)
  s (tap-hold $tap-time $hold-time s lalt)
  d (tap-hold $tap-time $hold-time d lmet)
  f (tap-hold $tap-time $hold-time f lsft)
  j (tap-hold $tap-time $hold-time j rsft)
  k (tap-hold $tap-time $hold-time k rmet)
  l (tap-hold $tap-time $hold-time l ralt)
  ; (tap-hold $tap-time $hold-time ; rctl)

  ;; Fork Alt+U backspace
  ;; altu (fork u bspc (lalt ralt))
)

(deflayer base
           f1 f2  f3  f4  f5  f6  f7  f8  f9  f10  f11  f12
                                                             bspc
                                  u
  @escctrl @a @s  @d  @f      h   @j  @k  @l  @;
  @fnl                  @sparr
)

(deflayer fn
    brdn brup _  _  _  _  prev pp next mute vold volu 
                                                       del
                          _
  _ _    _    _  _      _ _    _  _    _
  _                 _
)

(deflayer arrows
    _ _ _ _ _ _    _    _  _     _ _ _ 
                                                       _
                   -
  _ _ _ _ _   left down up right _
  _         _
)
