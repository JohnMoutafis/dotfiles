// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  // ─────────────────────────────────────────────────────────────────────────
  // DEBUG
  // Zed defaults: f4=Start, f5=Continue, f9(Editor)=ToggleBreakpoint
  // My keybindings: f9=StepOver
  // Note: f9 still toggles breakpoints when NOT in debugger_stopped context.
  // ─────────────────────────────────────────────────────────────────────────
  {
    "context": "debugger_stopped > Editor",
    "bindings": {
      "f9": "debugger::StepOver",
    },
  },
  // ─────────────────────────────────────────────────────────────────────────
  // Open LazyGit as a task inside a panel
  // Keymap: ctrl+shift+g
  // ─────────────────────────────────────────────────────────────────────────
  {
    "context": "Editor",
    "bindings": {
      // Focus/Toggle terminal from any Editor.
      "ctrl-t": "terminal_panel::ToggleFocus",
      // Move or Split and Move active editor to right/left panes
      "g >": ["workspace::MoveItemToPaneInDirection", { "direction": "right" }],
      "g <": ["workspace::MoveItemToPaneInDirection", { "direction": "left" }],
      "ctrl-shift-g": [
        "task::Spawn",
        {
          "task_name": "LazyGit",
          "reveal_target": "center",
        },
      ],
    },
  },
  // ─────────────────────────────────────────────────────────────────────────
  // PANE NAVIGATION — ctrl+hjkl (vim-style, everywhere)
  //
  // Overrides in Editor context:
  //   ctrl-h → editor::Backspace
  //   ctrl-l → editor::ScrollCursorCenter
  //   ctrl-j → editor::JoinLines  (Sublime binding)
  //   ctrl-k → editor::KillRingCut
  // Note: keeps ctrl-j/k for completion menu navigation in insert mode
  //
  // TAB / EDITOR NAVIGATION — vim normal mode
  //
  //   shift-L/H: next/prev tab in current pane
  //   space t  : open tab switcher
  //   space e  : toggle project panel
  //   space g  : toggle git panel
  //   space f  : toggle file finder
  // ─────────────────────────────────────────────────────────────────────────

  {
    "context": "Editor && !(vim_mode == insert || (showing_code_actions || showing_completions))",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-w": "pane::CloseActiveItem",
      "shift-l": "pane::ActivateNextItem",
      "shift-h": "pane::ActivatePreviousItem",
      "space t": "tab_switcher::Toggle",
      "space g": "git_panel::ToggleFocus",
      "space e": "project_panel::ToggleFocus",
      // "space f": "file_finder::Toggle",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      // Toggle off Terminal if focushed
      "ctrl-t": "terminal_panel::Toggle",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
    },
  },
  {
    "context": "Dock",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
    },
  },
  // ─────────────────────────────────────────────────────────────────────────
  // TAB / EDITOR NAVIGATION — vim normal mode
  //
  // shift-L/H: next/prev tab in current pane
  // space t  : open tab switcher
  // space e  : toggle project panel
  // ─────────────────────────────────────────────────────────────────────────
  {
    "context": "((vim_mode == normal || vim_mode == visual) || vim_mode == operator)",
    "bindings": {
      // nvim mini.move personal keybindings move line/selection up/down
      "alt-shift-j": "editor::MoveLineDown",
      "alt-shift-k": "editor::MoveLineUp",
    },
  },
  // ─────────────────────────────────────────────────────────────────────────
  // NVIM Snacks style file management in explorer
  // ─────────────────────────────────────────────────────────────────────────
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "n": "project_panel::NewFile",
      "shift-n": "project_panel::NewDirectory",
      "c": "project_panel::Copy",
      "shift-c": "project_panel::Cut",
      "p": "project_panel::Paste",
      "r": "project_panel::Rename",
      "d": "project_panel::Delete",
      // space+e while project panel is focused closes it and returns to editor
      "space e": "workspace::ToggleLeftDock",
    },
  },
  // ─────────────────────────────────────────────────────────────────────────
  // Custom Agent Keybindings
  // ─────────────────────────────────────────────────────────────────────────
  {
    "context": "AgentPanel",
    "bindings": {
      "alt-enter": "agent::AllowOnce",
    },
    "unbind": {
      "alt-shift-a": "agent::AllowOnce",
    },
  },
]
