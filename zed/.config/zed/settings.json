    "languages": {
        "Nim": {
            "auto_indent": "preserve_indent",
            "tab_size": 2,
            "formatter": {
                "external": {
                    "command": "nph",
                    "arguments": [
                        "-"
                    ],
                },
            },
        },
    },
    "ui_font_size": 14,
    "ui_font_family": "JetBrainsMono Nerd Font",
    "buffer_font_size": 14,
    "wrap_guides": [
        120
    ],
    "restore_on_startup": "last_workspace",
    "vim_mode": true,
    "vim": {
        "toggle_relative_line_numbers": true,
    },
    "autosave": "on_focus_change",
    "terminal": {
        "dock": "bottom",
        "font_size": 13,
        "font_family": "JetBrainsMono Nerd Font",
        "copy_on_select": true,
    },
    "theme": {
        "mode": "system",
        "light": "One Light",
        "dark": "New Darcula",
    },
}