// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent_servers": {
    "opencode": {
      "favorite_config_option_values": {
        "model": ["deepseek/deepseek-v4-pro"],
      },
      "type": "registry",
    },
  },
  "cli_default_open_behavior": "existing_window",
  "theme": {
    "mode": "system",
    "light": "New Darcula Light",
    "dark": "New Darcula",
  },
  "icon_theme": "Colored Zed Icons Theme Dark",
  // MCP & Agent config
  "context_servers": {
    "serena-ide": {
      "url": "http://localhost:9122/mcp",
      "enabled": true,
    },
  },
  "agent": {
    "default_profile": "write",
    "tool_permissions": {
      "tools": {
        "skill": {
          "default": "allow"
        },
        "mcp:serena:list_memories": {
          "default": "allow",
        },
        "mcp:serena:get_symbols_overview": {
          "default": "allow",
        },
        "mcp:serena:read_memory": {
          "default": "allow",
        },
      },
    },
    "profiles": {
      "orchestrator": {
        "name": "Orchestrator",
        "tools": {
          "open": true,
          "now": true,
          "go_to_definition": true,
          "grep": true,
          "list_directory": true,
          "read_file": true,
          "terminal": true,
          "spawn_agent": true,
          "get_code_actions": true,
          "find_references": true,
          "find_path": true,
          "diagnostics": true,
        },
        "enable_all_context_servers": true,
        "context_servers": {
          "serena": {
            "tools": {
              "find_declaration": true,
              "search_for_pattern": true,
              "read_memory": true,
              "list_memories": true,
              "onboarding": true,
              "initial_instructions": true,
              "get_symbols_overview": true,
              "get_diagnostics_for_file": true,
              "get_current_config": true,
              "find_implementations": true,
              "find_referencing_symbols": true,
              "find_symbol": true,
              "check_onboarding_performed": true,
              "activate_project": true,
            },
          },
        },
      },
      "plan": {
        "name": "Plan",
        "tools": {
          "go_to_definition": true,
          "find_references": true,
          "fetch": true,
          "read_file": true,
          "open": true,
          "now": true,
          "terminal": true,
          "search_web": true,
          "list_directory": true,
          "grep": true,
          "find_path": true,
          "diagnostics": true,
        },
        "enable_all_context_servers": true,
        "context_servers": {
          "serena": {
            "tools": {
              "edit_memory": true,
              "write_memory": true,
              "search_for_pattern": true,
              "read_memory": true,
              "list_memories": true,
              "initial_instructions": true,
              "get_symbols_overview": true,
              "get_diagnostics_for_file": true,
              "get_current_config": true,
              "find_symbol": true,
              "find_referencing_symbols": true,
              "find_implementations": true,
              "find_declaration": true,
              "check_onboarding_performed": true,
              "activate_project": true,
            },
          },
        },
      },
    },
    "default_model": {
      "effort": "max",
      "provider": "deepseek",
      "model": "deepseek-v4-pro",
      "enable_thinking": true,
    },
    "sidebar_side": "right",
    "dock": "right",
  },
  // Panels (Keep the left/old style of zed)
  "outline_panel": {
    "dock": "right",
  },
  "git_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
    "button": true,
  },
  "project_panel": {
    "dock": "left",
  },
  "base_keymap": "VSCode",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  // Integrated terminal
  "terminal": {
    "dock": "bottom",
    "font_size": 13,
    "font_family": "JetBrainsMono Nerd Font",
    "copy_on_select": true,
    "detect_venv": {
      "on": {
        "directories": [".env", "env", ".venv", "venv"],
        "activate_script": "default",
      },
    },
  },
  // UI and behavior
  "ui_font_size": 14,
  "ui_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 14,
  "wrap_guides": [120],
  "restore_on_startup": "last_workspace",
  "autosave": "on_focus_change",
  "vim_mode": true,
  "vim": {
    "toggle_relative_line_numbers": true,
  },
  // Languages
  "languages": {
    "Python": {
      "language_servers": [
        // https://docs.astral.sh/ty/editors/#zed
        // Enable ty and ruff,
        // Other built-in servers (basedpyright, pyright, pylsp)
        // are disabled by being omitted from this list.
        "ty",
        "ruff",
      ],
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.organizeImports.ruff": true, // Organize imports
        "source.fixAll.ruff": true, // Fix all auto-fixable lint violations
      },
    },
    "Django": {
      "language_servers": ["django-language-server", "django-template-lsp"],
    },
    "Nim": {
      "auto_indent": "preserve_indent",
      "tab_size": 2,
      "formatter": {
        "external": {
          "command": "nph",
          "arguments": ["-"],
        },
      },
    },
  },
  "global_lsp_settings": {
    "semantic_token_rules": [{ "token_type": "combined" }],
  },
  "file_scan_exclusions": [
    "**/__pycache__",
    "**/.ruff_cache",
    // default values below
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
  ],
}
